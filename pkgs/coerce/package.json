{
  "name": "@js-fns/coerce",
  "version": "0.1.1",
  "description": "Lightweight type coercion library",
  "license": "MIT",
  "author": "Sasha Koss <koss@nocorp.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kossnocorp/js-fns.git"
  },
  "type": "module",
  "main": "index.cjs",
  "module": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "index.cjs",
    "module": "index.js",
    "types": "./index.d.ts",
    "exports": {
      ".": {
        "require": {
          "types": "./index.d.cts",
          "default": "./index.cjs"
        },
        "import": {
          "types": "./index.d.ts",
          "default": "./index.js"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@js-fns/dev": "workspace:*",
    "@types/node": "^24.13.3",
    "vitest": "4.1.10"
  }
}
