{
  "name": "@js-fns/xxhash",
  "version": "0.1.1",
  "description": "Tiny xxHash JS implementation",
  "license": "MIT",
  "author": "Sasha Koss <koss@nocorp.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kossnocorp/js-fns.git"
  },
  "type": "module",
  "main": "index.cjs",
  "module": "index.js",
  "types": "./index.d.ts",
  "imports": {
    "#xxhash/canon": "@js-fns/canon"
  },
  "exports": {
    ".": "./src/index.ts",
    "./xxh32": "./src/xxh32.ts",
    "./xxh64": "./src/xxh64.ts",
    "./str": "./src/str/index.ts",
    "./str/xxh32Str": "./src/str/xxh32Str.ts",
    "./str/xxh64Str": "./src/str/xxh64Str.ts",
    "./any": "./src/any/index.ts",
    "./any/xxh32Any": "./src/any/xxh32Any.ts",
    "./any/xxh64Any": "./src/any/xxh64Any.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "index.cjs",
    "module": "index.js",
    "types": "./index.d.ts",
    "exports": {
      ".": {
        "require": {
          "types": "./index.d.cts",
          "default": "./index.cjs"
        },
        "import": {
          "types": "./index.d.ts",
          "default": "./index.js"
        }
      },
      "./xxh32": {
        "require": {
          "types": "./xxh32.d.cts",
          "default": "./xxh32.cjs"
        },
        "import": {
          "types": "./xxh32.d.ts",
          "default": "./xxh32.js"
        }
      },
      "./xxh64": {
        "require": {
          "types": "./xxh64.d.cts",
          "default": "./xxh64.cjs"
        },
        "import": {
          "types": "./xxh64.d.ts",
          "default": "./xxh64.js"
        }
      },
      "./str": {
        "require": {
          "types": "./str/index.d.cts",
          "default": "./str/index.cjs"
        },
        "import": {
          "types": "./str/index.d.ts",
          "default": "./str/index.js"
        }
      },
      "./str/xxh32Str": {
        "require": {
          "types": "./str/xxh32Str.d.cts",
          "default": "./str/xxh32Str.cjs"
        },
        "import": {
          "types": "./str/xxh32Str.d.ts",
          "default": "./str/xxh32Str.js"
        }
      },
      "./str/xxh64Str": {
        "require": {
          "types": "./str/xxh64Str.d.cts",
          "default": "./str/xxh64Str.cjs"
        },
        "import": {
          "types": "./str/xxh64Str.d.ts",
          "default": "./str/xxh64Str.js"
        }
      },
      "./any": {
        "require": {
          "types": "./any/index.d.cts",
          "default": "./any/index.cjs"
        },
        "import": {
          "types": "./any/index.d.ts",
          "default": "./any/index.js"
        }
      },
      "./any/xxh32Any": {
        "require": {
          "types": "./any/xxh32Any.d.cts",
          "default": "./any/xxh32Any.cjs"
        },
        "import": {
          "types": "./any/xxh32Any.d.ts",
          "default": "./any/xxh32Any.js"
        }
      },
      "./any/xxh64Any": {
        "require": {
          "types": "./any/xxh64Any.d.cts",
          "default": "./any/xxh64Any.cjs"
        },
        "import": {
          "types": "./any/xxh64Any.d.ts",
          "default": "./any/xxh64Any.js"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@js-fns/canon": "workspace:*",
    "@js-fns/dev": "workspace:*",
    "@types/node": "^24.13.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@js-fns/canon": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@js-fns/canon": {
      "optional": true
    }
  }
}
